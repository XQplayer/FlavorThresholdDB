# 虚拟环境
.venv/
Scripts/
Include/
/Lib/

# Keep project-owned reproducible data pipelines; `Scripts/` above is only for
# root-level Python virtual environments and is case-insensitive on Windows.
!/scripts/
!/scripts/**

# 编译和缓存文件
__pycache__/
*.pyc

# IDE 配置文件
.idea/
.vscode/

# 其他环境或大文件
*.log

# 本地依赖与构建输出
node_modules/
frontend/node_modules/
frontend/dist/

# 原始文献、实验数据和本地网页缓存
*.pdf
*.docx
*.xlsx
*.xls
!resources/shimadzu/templates/*.xlsx
data/
Flavor Library _ FEMA.html
Flavor Library _ FEMA_files/

# 批处理结果与运行时文件
batch_extracted*.json
batch_output_summary.json
internal_standard_scan.json
semiquant_summary.json
*.pid
*.err
supabase/.temp/

# Local release candidates, verification artifacts, and offline backups.
# These files must never be committed or deployed.
_local/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite.gz
*.sqlite.zst
.media-build/
/.playwright-cli/
/.superpowers/
/.worktrees/

# 由于前端有自己的 .gitignore，所以 node_modules 会被默认过滤
